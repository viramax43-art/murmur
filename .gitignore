# Dependencies (the game itself has none; this is for tooling only)
node_modules/

# Blender human base meshes, ~100 MB. Refetch with tools/blender/fetch_assets.ps1
tools/blender/cache/

# Probe renders, crop sheets and render logs
tools/blender/out/

# Slicer reports (contact sheets) - rebuilt by `npm run sprites`
tools/out/

# The downloaded art pack; the sheet it carries lives in assets/source/murmur/
murmur_art_pack.zip

# Python bytecode
__pycache__/
*.pyc

# OS noise
Thumbs.db
.DS_Store
